# ============================================================
# FinanceOS - Backend Environment Configuration Template
# Copy this file to .env and configure your local or production values.
# NEVER commit your actual .env file with secrets to Git.
# ============================================================

# Server Port (default 5000)
PORT=5000

# MongoDB Connection URI (Required)
# Example: mongodb://127.0.0.1:27017/financeos or MongoDB Atlas URI
MONGO_URI=

# JWT Secret Key for Session Authentication (Required)
JWT_SECRET=

# Email Notification Delivery Service (Gmail SMTP)
# Leave blank to run FinanceOS with In-App notifications only
EMAIL_USER=
EMAIL_PASSWORD=

# Optional Default Administrator Email
ADMIN_EMAIL=

# Google Gemini API Key for AI Financial Adviser (Optional)
# If not provided, FinanceOS automatically uses its deterministic rule-based analysis engine
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Node Environment (development | production)
NODE_ENV=development
