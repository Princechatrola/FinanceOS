# ============================================================
# FinanceOS - Production Git Ignore Configuration
# ============================================================

# Dependencies
node_modules/
jspm_packages/
web_modules/

# Environment variable files (NEVER commit secrets)
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example

# Local MongoDB database directories and WiredTiger binary data
backend/data/
data/
*.wt
*.lock
*.bson
mongod.lock

# Test artifacts and screenshots
backend/screenshots/
screenshots/
coverage/
.nyc_output/
*.lcov

# Build outputs
dist/
dist-ssr/
build/
.output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite and bundler cache
.vite/
.cache/
.parcel-cache/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Runtime data & temp files
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
uploads/
patch*.cjs
check.cjs

